# SSH Connection Details (Optional)
# If not set, the server will ask for credentials in chat via ssh_connect tool

SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USERNAME=root
SSH_PASSWORD=your-password-here

# For SSH key-based authentication (use instead of SSH_PASSWORD)
# SSH_KEY_PATH=/path/to/your/private/key

# Credential cache directory (optional, defaults to ~/.ssh-mcp-cache)
# SSH_MCP_CACHE_DIR=/custom/cache/path
