# SSH Connection Details
# Pass via environment variables or connect dynamically via ssh_connect tool

SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USERNAME=ubuntu
SSH_PASSWORD=your-ssh-password-here

# For SSH key-based authentication (use instead of SSH_PASSWORD)
# SSH_KEY_PATH=/path/to/your/private/key

# Credential cache directory (optional, defaults to ~/.ssh-mcp-cache)
# SSH_MCP_CACHE_DIR=/tmp/ssh-mcp-cache
